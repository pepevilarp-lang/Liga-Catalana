rules_version = '2';
// Reglas de Firestore de la app. Se publican a mano: Firebase > Firestore Database > Reglas > pegar este archivo > Publicar.
// Reflejan los permisos de la app (app.js, función updRoles):
//   - Administrador: colección admins (id = UID o correo en minúsculas). Todo.
//   - Gestor del club: correo en meta/app.managerEmails. Todos los equipos, sin necesidad de ser jugador.
//   - Capitán: su pid está en seasons/{temporada}.captains. Datos privados de su equipo y gestión del MVP.
//   - Jugador del equipo: su pid está en seasons/{temporada}.memberIds (o la lista está vacía). Edita su equipo
//     mientras rules.teamManage no sea false.
//   - Vincular un Gmail a un jugador: directamente (cada ficha a un solo Gmail) salvo que un administrador ponga
//     meta/app.openClaims = false; entonces exige invitación (invites/{código}) o que el club valide la solicitud. Ser gestor exige que un administrador lo añada o apruebe su solicitud (clubRequests).
// Elegir un rol en la pantalla de entrada no da permisos: todo se decide aquí. Plan multiclub: docs/MULTICLUB.md
// Las funciones de Vercel (api/*) usan la cuenta de servicio y no pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(email())));
    }
    // Identificador del club de este proyecto (club-config.js → id)
    function clubId() { return 'rcpb'; }
    function memberDoc(c) { return /databases/$(database)/documents/clubs/$(c)/members/$(request.auth.uid); }
    // Gestor: en la lista meta/app.managerEmails o aprobado/invitado en clubs/<club>/members/<uid>
    function isManager() {
      return signedIn() && (email() in get(/databases/$(database)/documents/meta/app).data.get('managerEmails', [])
        || (exists(memberDoc(clubId())) && 'gestor' in get(memberDoc(clubId())).data.get('roles', [])));
    }
    function isStaff() { return isAdmin() || isManager(); }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myPid() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pid; }
    function isMe(pid) { return isMember() && myPid() == pid; }
    function canRead() { return isMember() || isStaff(); }

    // Temporada de un equipo
    function season(s) { return get(/databases/$(database)/documents/seasons/$(s)).data; }
    function isCaptainOf(s) { return isMember() && myPid() in season(s).get('captains', []); }
    function inTeam(s) {
      return isMember() && (season(s).get('memberIds', []).size() == 0 || myPid() in season(s).get('memberIds', []));
    }
    function teamManage(s) { return season(s).get('rules', {}).get('teamManage', true) != false; }
    // Editar la temporada del equipo (calendario, convocatoria, resultados, documentos...)
    function canEdit(s) { return isStaff() || isCaptainOf(s) || (teamManage(s) && inTeam(s)); }
    // Datos privados del equipo (respuestas individuales, comentarios, quién votó a quién)
    function canPrivate(s) { return isStaff() || isCaptainOf(s); }

    // Invitaciones: el código existe, es de ese jugador, no ha caducado ni se ha usado, y se marca como usado en el mismo lote
    function openClaims() { return get(/databases/$(database)/documents/meta/app).data.get('openClaims', true) != false; }
    function inviteOk(pid) {
      let code = request.resource.data.get('invite', '-');
      let inv = /databases/$(database)/documents/invites/$(code);
      return code is string && code.size() >= 6 && exists(inv)
        && get(inv).data.pid == pid
        && get(inv).data.get('usedBy', null) == null
        && get(inv).data.exp > request.time.toMillis()
        && getAfter(inv).data.usedBy == request.auth.uid;
    }

    // Invitación de gestor válida para ese club, usada en el mismo lote por quien se da de alta
    function gestorInviteOk(c, uid) {
      let code = request.resource.data.get('invite', '-');
      let inv = /databases/$(database)/documents/invites/$(code);
      return signedIn() && uid == request.auth.uid && code is string && code.size() >= 6 && exists(inv)
        && get(inv).data.get('role', '') == 'gestor' && get(inv).data.club == c
        && get(inv).data.get('usedBy', null) == null && get(inv).data.exp > request.time.toMillis()
        && getAfter(inv).data.usedBy == request.auth.uid
        && request.resource.data.roles == ['gestor'];
    }

    // El recuento solo sube en uno, y solo para el jugador del voto que se crea en el mismo lote
    function validVoteTally(s, k) {
      let vote = /databases/$(database)/documents/seasons/$(s)/mvp/$(k)/votes/$(myPid());
      let v = getAfter(vote).data.v;
      let before = resource == null ? {} : resource.data;
      let t0 = before.get('t', {});
      let t1 = request.resource.data.get('t', {});
      return isMember() && !exists(vote) && existsAfter(vote)
        && request.resource.data.diff(before).affectedKeys().hasOnly(['t', 'n'])
        && request.resource.data.get('n', 0) == before.get('n', 0) + 1
        && t1.diff(t0).affectedKeys().hasOnly([v])
        && t1.get(v, 0) == t0.get(v, 0) + 1;
    }

    // Administradores: se crean a mano en la consola
    match /admins/{id} {
      allow read: if signedIn() && (id == request.auth.uid || id == email());
      allow write: if false;
    }

    // Nombre de la lista ligado a un Gmail. Uno por jugador y uno por Gmail.
    match /claims/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && (openClaims() || inviteOk(pid));
      allow update: if signedIn()
        && resource.data.email == email()
        && request.resource.data.email == email()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == email()
        && getAfter(/databases/$(database)/documents/claims/$(request.resource.data.pid)).data.uid == uid;
      allow delete: if isAdmin() || uid == request.auth.uid;
    }

    // Configuración del club (temporadas, equipos, gestores, informe automático). La leen también los gestores que no juegan.
    // Los gestores cambian la configuración, pero la lista de gestores y el acceso sin invitación solo un administrador.
    match /meta/{doc} {
      allow read: if canRead();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isManager()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managers', 'managerEmails', 'openClaims']));
      allow delete: if isAdmin();
    }
    // Invitaciones: de jugador (las crean capitanes y gestión) o de gestor (solo gestión). Se leen conociendo el código
    // y las usa el invitado una vez, en el mismo lote que crea su vínculo.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.get('usedBy', null) == null
        && request.resource.data.exp is int
        && request.resource.data.exp <= request.time.toMillis() + 2678400000
        && ((request.resource.data.get('role', 'jugador') == 'gestor' && isStaff() && request.resource.data.club == clubId())
          || (request.resource.data.get('role', 'jugador') != 'gestor' && request.resource.data.pid is string && canPrivate(request.resource.data.season)));
      allow update: if signedIn() && resource.data.get('usedBy', null) == null
        && resource.data.exp > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && ((resource.data.get('role', 'jugador') == 'gestor'
              && 'gestor' in getAfter(/databases/$(database)/documents/clubs/$(resource.data.club)/members/$(request.auth.uid)).data.roles)
          || (resource.data.get('role', 'jugador') != 'gestor'
              && getAfter(/databases/$(database)/documents/claims/$(resource.data.pid)).data.uid == request.auth.uid));
      allow delete: if isStaff() || (resource.data.get('role', 'jugador') != 'gestor' && canPrivate(resource.data.season));
    }
    // Acceso sin invitación activado (copia pública de meta/app.openClaims para la pantalla de entrada)
    match /public/access {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Catálogo de clubes de la FCT (importado por un administrador)
    match /catalog/{id} {
      allow read: if true;   // datos públicos de la FCT: el buscador de clubes se usa antes de iniciar sesión
      allow write: if isAdmin();
    }
    // Solicitudes para vincularse a un club (como gestor o jugador): las crea el interesado y las resuelve un
    // administrador o un gestor de ese club; las de jugador con ficha propuesta, también el capitán de ese equipo.
    // Un gestor solo ve las de su club y un capitán solo las de su equipo.
    function reqCaptain() {
      return resource.data.get('role', '') == 'jugador' && resource.data.get('season', '') != '' && isCaptainOf(resource.data.season);
    }
    match /clubRequests/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin() || (isManager() && resource.data.clubId == clubId()) || reqCaptain());
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.role in ['gestor', 'jugador']
        && request.resource.data.status == 'pendiente'
        && (resource == null || resource.data.status != 'aprobada');
      allow update: if isAdmin() || (isManager() && resource.data.clubId == clubId() && request.resource.data.clubId == clubId())
        || (reqCaptain() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'invite', 'pid', 'decidedBy', 'decidedByEmail', 'decidedAt']));
      allow delete: if isAdmin() || (uid == request.auth.uid && resource.data.status != 'aprobada');
    }
    // Identidad de cada club (colores, contacto) y sus miembros aprobados
    match /clubs/{club} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /members/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isAdmin() || (isManager() && club == clubId()));
        allow create: if isAdmin() || (isManager() && club == clubId()) || gestorInviteOk(club, uid);
        allow update, delete: if isAdmin() || (isManager() && club == clubId());
      }
    }
    // Lista pública de nombres por equipo, para elegir el tuyo al entrar
    match /public/{doc} {
      allow read: if signedIn();
      allow write: if canRead() && doc != 'access';
    }
    // Fotos recortadas (una por jugador; _team = foto del equipo). Las sube el propio jugador o quien gestiona el equipo.
    match /photos/{id} {
      allow read: if canRead();
      allow create, update: if canRead() && request.resource.data.d is string && request.resource.data.d.size() < 950000;
      allow delete: if canRead();
    }
    // Ficha de tenista: la lee el club; la edita su dueño o la gestión
    match /profiles/{pid} {
      allow read: if canRead();
      allow write: if isMe(pid) || isStaff();
    }
    // Teléfonos para recordatorios y WhatsApp: los ven y editan quienes gestionan equipos
    match /phones/{pid} {
      allow read, write: if canRead();
    }
    // Tokens de notificaciones: cada jugador añade los suyos; solo los lee el servidor
    match /pushTokens/{pid} {
      allow read: if isAdmin();
      allow create, update: if isMe(pid) || isStaff();
      allow delete: if isAdmin();
    }
    // Registro de envíos del resumen semanal
    match /reports/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    // Uso antiguo, solo administradores
    match /private/{doc} { allow read, write: if isAdmin(); }

    match /seasons/{s} {
      allow read: if canRead();
      allow create: if isStaff();
      // Capitanes, reglas de permisos y equipo solo los cambia la gestión
      allow update: if canEdit(s) && (isStaff() || (
        request.resource.data.get('rules', {}) == resource.data.get('rules', {}) &&
        (!('captains' in resource.data) || request.resource.data.get('captains', []) == resource.data.captains) &&
        request.resource.data.get('teamId', null) == resource.data.get('teamId', null)));
      allow delete: if isAdmin();

      // Disponibilidad: la ve el equipo, cada uno escribe la suya; quien gestiona puede anotar a mano
      match /avail/{pid} { allow read: if canRead(); allow write: if isMe(pid) || canEdit(s); }
      // Comentarios de disponibilidad: su autor, capitanes y gestión
      match /availNotes/{pid} { allow read, write: if isMe(pid) || canPrivate(s); }
      // Pronósticos
      match /picks/{pid} { allow read: if canRead(); allow write: if isMe(pid) || isStaff(); }
      // Encuestas postpartido: privadas
      match /ballots/{pid} { allow read, write: if isMe(pid) || canPrivate(s); }
      // Documentos (troceados) y fotos diarias de la temporada
      match /docs/{id} {
        allow read: if canRead();
        allow write: if canEdit(s);
        match /chunks/{n} { allow read: if canRead(); allow write: if canEdit(s); }
      }
      match /snapshots/{d} { allow read: if canRead(); allow write: if canEdit(s); }

      // MVP de cada jornada. Recuento público; quién votó a quién, privado.
      // Un voto por jugador, nunca a uno mismo y sin poder cambiarlo. Solo capitanes y gestión anulan.
      match /mvp/{k} {
        allow read: if canRead();
        allow write: if canPrivate(s) || validVoteTally(s, k);

        match /votes/{voter} {
          allow read: if isMe(voter) || canPrivate(s);
          allow create: if isMe(voter) && inTeam(s)
            && request.resource.data.keys().hasOnly(['v', 'at'])
            && request.resource.data.v is string
            && request.resource.data.v != voter
            && existsAfter(/databases/$(database)/documents/seasons/$(s)/mvp/$(k));
          allow update: if false;
          allow delete: if canPrivate(s);
        }
      }
    }
  }
}
