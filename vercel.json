{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(app.js|access.js|club.js|club-config.js|report-doc.js|season-views.js|automation.js|styles.css|config.js|index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/remind",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/fct-sync",
      "schedule": "30 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:fn(access-request|auto-report|extract|fct-clubs|migrate|notify|send-invite|send-report|write-report|wa-webhook|client-error|photo)",
      "destination": "/api/h?fn=:fn"
    }
  ]
}
